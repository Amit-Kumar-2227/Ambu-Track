rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validState() {
      let d = request.resource.data;
      let s = d.state;
      return d.keys().hasAll(['revision', 'state', 'mutationId', 'updatedAt'])
        && d.keys().hasOnly(['revision', 'state', 'mutationId', 'updatedAt'])
        && d.revision is int && d.revision >= 0
        && d.mutationId is string && d.mutationId.size() <= 100
        && d.updatedAt == request.time
        && s is map
        && s.keys().hasAll(['schemaVersion', 'units', 'hospitals', 'history', 'activeTrip', 'settings'])
        && s.keys().hasOnly(['schemaVersion', 'units', 'hospitals', 'history', 'activeTrip', 'settings'])
        && s.schemaVersion == 1
        && s.units is list && s.units.size() > 0 && s.units.size() <= 20
        && s.hospitals is list && s.hospitals.size() > 0 && s.hospitals.size() <= 20
        && s.history is list && s.history.size() <= 100
        && (s.activeTrip == null || s.activeTrip is map)
        && s.settings is map;
    }
    match /users/{uid}/ambutrack/state {
      allow read: if owns(uid);
      allow create: if owns(uid) && validState() && request.resource.data.revision == 0;
      allow update: if owns(uid) && validState()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
